<?xml version="1.0" encoding="utf-8"?>
<!--
  Цветовые токены DPpass, светлая тема (D-34). Тёмная — values-night/colors.xml
  с теми же именами. Текст на фоне и на поверхности — контраст не ниже
  WCAG AA (4,5:1); вторичный текст — тоже. Граница и состояние элемента
  управления — не ниже 3:1 (WCAG 1.4.11): `outline_strong`; `outline` —
  только украшения (разделители, обводка карточки). Пары и пороги держит
  tools/hostcheck/check_contrast.py.
-->
<resources>
    <color name="bg">#FFF4F6FA</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_variant">#FFEBEEF5</color>
    <color name="outline">#FFD8DCE6</color>
    <color name="outline_strong">#FF7A8194</color>
    <color name="text">#FF11141B</color>
    <color name="text_secondary">#FF586072</color>
    <color name="primary">#FF2453C2</color>
    <color name="on_primary">#FFFFFFFF</color>
    <color name="primary_container">#FFDCE5FF</color>
    <color name="on_primary_container">#FF0E2A6B</color>
    <color name="success">#FF187A4C</color>
    <color name="success_container">#FFD5F3E3</color>
    <color name="warning">#FF9A5A00</color>
    <color name="warning_container">#FFFFEFD3</color>
    <color name="error">#FFB3261E</color>
    <color name="error_container">#FFFBE2E0</color>
    <color name="ripple">#1F11141B</color>
</resources>
