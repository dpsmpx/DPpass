<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка-контур (D-34): граница — `outline_strong`, не ниже 3:1 к фону (WCAG 1.4.11). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/outline_strong" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</ripple>
