<?xml version="1.0" encoding="utf-8"?>
<!--
  Выбранный сегмент (D-34): плашка с отступом 4 dp сверху и снизу — касаемая
  область сегмента 48 dp, видимая плашка 40 dp, — и линия снизу внутри плашки:
  выбранный отличается не только цветом текста, линия не ниже 3:1 к плашке
  (WCAG 1.4.11, выбор автора 18.10.2026). Цвета — здесь, не backgroundTintList:
  оттенок закрасил бы и линию.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:gravity="bottom"
        android:height="2dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
