  "dns": {
    "servers": [
      {
        "id": "remote",
        "type": "https",
        "url": "https://dns.example.net/dns-query",
        "route": "tunnel"
      },
      {
        "id": "local",
        "type": "system",
        "route": "direct"
      }
    ],
    "default": "remote",
    "rules": [
      {
        "domain_suffix": [
          "example.ru"
        ],
        "server": "local"
      }
    ],
    "strategy": "prefer_ipv4",
