{
  "log": {
    "loglevel": "none",
    "dnsLog": false
  },
  "dns": {
    "tag": "dppass:dns",
    "servers": [
      {
        "address": "localhost",
        "tag": "dns:serverless",
        "finalQuery": true
      }
    ],
    "queryStrategy": "UseIP",
    "disableFallbackIfMatch": true
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "ruleTag": "dppass:dns-hijack",
        "inboundTag": [
          "tun-in"
        ],
        "ip": [
          "172.19.0.2"
        ],
        "port": "53",
        "outboundTag": "dns-out"
      },
      {
        "ruleTag": "dppass:split-quic",
        "inboundTag": [
          "tun-in"
        ],
        "domain": [
          "domain:example.org",
          "geosite:example-a"
        ],
        "port": "443",
        "network": "udp",
        "outboundTag": "block"
      },
      {
        "ruleTag": "dppass:split-sites",
        "inboundTag": [
          "tun-in"
        ],
        "domain": [
          "domain:example.org",
          "geosite:example-a"
        ],
        "network": "tcp",
        "outboundTag": "proxy"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "settings": {
        "name": "dppass0",
        "mtu": 1500
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4v6"
        }
      },
      "settings": {
        "fragment": {
          "packets": "tlshello",
          "length": "40-80",
          "interval": "1-3"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4v6"
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "rules": [
          {
            "action": "hijack",
            "qType": "1,28"
          },
          {
            "action": "return",
            "rCode": 0
          }
        ]
      }
    }
  ],
  "stats": {},
  "policy": {
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  }
}
